--langmap=swift:.swift
--regex-swift=/(^|[^[:alnum:]_])class[[:space:]]+([[:alnum:]_]+)/\2/c,class/
--regex-swift=/(^|[^[:alnum:]_])enum[[:space:]]+([[:alnum:]_]+)/\2/e,enum/
--regex-swift=/(^|[^[:alnum:]_])func[[:space:]]+([[:alnum:]_]+)/\2/f,function/
--regex-swift=/(^|[^[:alnum:]_])protocol[[:space:]]+([[:alnum:]_]+)/\2/P,protocol/
